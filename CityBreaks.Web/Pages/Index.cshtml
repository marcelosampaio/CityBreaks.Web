
@page
@model IndexModel
@{
    ViewData["Title"] = "CityBreaks";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Cities and Properties</h1>

        <a asp-page="/CreateProperty" class="btn btn-secondary">
            Create Property
        </a>
    </div>

    @foreach (var city in Model.Cities)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="card-title">@city.Name</h2>
                <h5 class="card-subtitle mb-3 text-muted">@city.Country.CountryName</h5>

                @if (city.Properties.Any())
                {
                    <h6>Properties</h6>

                    <ul class="list-group">
                        @foreach (var property in city.Properties)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@property.Name</span>

                                <div class="d-flex align-items-center gap-3">
                                    <span>@property.PricePerNight.ToString("C")</span>

                                    <a asp-page="/EditProperty"
                                       asp-route-id="@property.Id"
                                       class="btn btn-secondary btn-sm">
                                        Edit
                                    </a>

                                    <form method="post"
                                          asp-page-handler="Delete"
                                          asp-route-id="@property.Id">
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>No properties registered.</p>
                }

                <a asp-page="/CityDetails"
                   asp-route-name="@city.Name"
                   class="btn btn-secondary mt-3">
                    View Details
                </a>
            </div>
        </div>
    }
</div>
