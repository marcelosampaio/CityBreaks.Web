@page
@model CreatePropertyModel
@{
    ViewData["Title"] = "Create Property";
}

<div class="container">
    <h1 class="mb-4">Create Property</h1>

    <form method="post">
        <div class="mb-3">
            <label asp-for="Property.Name" class="form-label">Property Name</label>
            <input asp-for="Property.Name" class="form-control" />
            <span asp-validation-for="Property.Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Property.PricePerNight" class="form-label">Price Per Night</label>
            <input asp-for="Property.PricePerNight" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Property.PricePerNight" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Property.CityId" class="form-label">City</label>
            <select asp-for="Property.CityId" asp-items="Model.Cities" class="form-select">
                <option value="">Select a city</option>
            </select>
            <span asp-validation-for="Property.CityId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-secondary">Create Property</button>
        <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>