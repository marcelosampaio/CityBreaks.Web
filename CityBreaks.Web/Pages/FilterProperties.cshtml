
@page
@model CityBreaks.Web.Pages.FilterPropertiesModel
@{
    ViewData["Title"] = "Filter Properties";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Filter Properties</h1>

        <a asp-page="/Index" class="btn btn-secondary">
            Back to Cities
        </a>
    </div>

    <form method="get" class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MinPrice" class="form-label">Minimum Price</label>
                    <input asp-for="MinPrice" type="number" step="0.01" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="MaxPrice" class="form-label">Maximum Price</label>
                    <input asp-for="MaxPrice" type="number" step="0.01" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="CityName" class="form-label">City</label>
                    <input asp-for="CityName" class="form-control" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="PropertyName" class="form-label">Property Name</label>
                    <input asp-for="PropertyName" class="form-control" />
                </div>
            </div>

            <button type="submit" class="btn btn-secondary">Filter</button>
            <a asp-page="/FilterProperties" class="btn btn-secondary">Clear</a>
        </div>
    </form>

    <h2 class="mb-3">Applied Filters</h2>

    <ul>
        @if (Model.MinPrice.HasValue)
        {
            <li>Minimum Price: @Model.MinPrice.Value.ToString("C")</li>
        }

        @if (Model.MaxPrice.HasValue)
        {
            <li>Maximum Price: @Model.MaxPrice.Value.ToString("C")</li>
        }

        @if (!string.IsNullOrWhiteSpace(Model.CityName))
        {
            <li>City: @Model.CityName</li>
        }

        @if (!string.IsNullOrWhiteSpace(Model.PropertyName))
        {
            <li>Property Name: @Model.PropertyName</li>
        }

        @if (!Model.MinPrice.HasValue &&
             !Model.MaxPrice.HasValue &&
             string.IsNullOrWhiteSpace(Model.CityName) &&
             string.IsNullOrWhiteSpace(Model.PropertyName))
        {
            <li>No filters applied.</li>
        }
    </ul>

    <h2 class="mb-3">Results</h2>

    @if (Model.Properties.Any())
    {
        <ul class="list-group">
            @foreach (var property in Model.Properties)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@property.Name</strong>
                        <div class="text-muted">@property.City.Name</div>
                    </div>

                    <span>@property.PricePerNight.ToString("C")</span>
                </li>
            }
        </ul>
    }
    else
    {
        <p>No properties found.</p>
    }
</div>
